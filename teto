import React, { useState, useEffect, useMemo } from 'react';
import {
  Smartphone, Wallet, LayoutDashboard, Settings as SettingsIcon, Plus, X, Search,
  Phone, CheckCircle2, Clock, Wrench, TrendingUp, Lock, Eye, EyeOff, Trash2,
  Edit2, LogOut, Store, ShieldCheck, ChevronLeft, AlertCircle, PackageCheck,
  Banknote, Receipt, User, Download, Upload, ClipboardCheck, DatabaseBackup
} from 'lucide-react';

const APP_USER_NAME = 'طارق بلال';
const DEFAULT_PASSWORD = 'teto9090@&$';

const STATUS = {
  received: { label: 'مستلم', color: '#4C8DFF', bg: 'rgba(76,141,255,0.14)', icon: PackageCheck },
  in_progress: { label: 'قيد الإصلاح', color: '#F5A524', bg: 'rgba(245,165,36,0.14)', icon: Wrench },
  ready: { label: 'جاهز للتسليم', color: '#2DD4BF', bg: 'rgba(45,212,191,0.14)', icon: Clock },
  delivered: { label: 'تم التسليم', color: '#22C55E', bg: 'rgba(34,197,94,0.16)', icon: CheckCircle2 },
};

const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 8);

const emptyForm = {
  id: null,
  customerName: '',
  phone: '',
  deviceName: '',
  model: '',
  issue: '',
  price: '',
  deposit: '',
  status: 'received',
  notes: '',
  dateReceived: new Date().toISOString().slice(0, 10),
  dateDelivered: '',
};

export default function App() {
  const [booting, setBooting] = useState(true);
  const [authed, setAuthed] = useState(false);
  const [authPassword, setAuthPassword] = useState(DEFAULT_PASSWORD);
  const [pwInput, setPwInput] = useState('');
  const [showPw, setShowPw] = useState(false);
  const [loginError, setLoginError] = useState('');

  const [shopName, setShopName] = useState('محل الصيانة');
  const [devices, setDevices] = useState([]);
  const [expenses, setExpenses] = useState([]);
  const [dataLoaded, setDataLoaded] = useState(false);

  const [tab, setTab] = useState('dashboard');
  const [search, setSearch] = useState('');
  const [statusFilter, setStatusFilter] = useState('all');
  const [showForm, setShowForm] = useState(false);
  const [form, setForm] = useState(emptyForm);
  const [confirmDeleteId, setConfirmDeleteId] = useState(null);

  const [showExpenseForm, setShowExpenseForm] = useState(false);
  const [expenseForm, setExpenseForm] = useState({ title: '', amount: '', date: new Date().toISOString().slice(0, 10) });

  const [pwForm, setPwForm] = useState({ current: '', next: '', confirm: '' });
  const [pwMsg, setPwMsg] = useState({ type: '', text: '' });
  const [shopNameDraft, setShopNameDraft] = useState('');

  const [showBackupModal, setShowBackupModal] = useState(false);
  const [copyState, setCopyState] = useState('idle'); // idle | copied
  const [showImportModal, setShowImportModal] = useState(false);
  const [importText, setImportText] = useState('');
  const [importMsg, setImportMsg] = useState({ type: '', text: '' });

  // Boot: load password + settings (not sensitive, safe pre-login)
  useEffect(() => {
    (async () => {
      try {
        const pw = await window.storage.get('auth-password', false);
        if (pw && pw.value) setAuthPassword(pw.value);
      } catch (e) {}
      try {
        const s = await window.storage.get('shop-settings', false);
        if (s && s.value) {
          const parsed = JSON.parse(s.value);
          if (parsed.shopName) setShopName(parsed.shopName);
        }
      } catch (e) {}
      setBooting(false);
    })();
  }, []);

  // Load app data after auth
  useEffect(() => {
    if (!authed) return;
    (async () => {
      try {
        const d = await window.storage.get('devices', false);
        setDevices(d && d.value ? JSON.parse(d.value) : []);
      } catch (e) { setDevices([]); }
      try {
        const ex = await window.storage.get('expenses', false);
        setExpenses(ex && ex.value ? JSON.parse(ex.value) : []);
      } catch (e) { setExpenses([]); }
      setDataLoaded(true);
    })();
  }, [authed]);

  const saveDevices = async (next) => {
    setDevices(next);
    try { await window.storage.set('devices', JSON.stringify(next), false); } catch (e) {}
  };
  const saveExpenses = async (next) => {
    setExpenses(next);
    try { await window.storage.set('expenses', JSON.stringify(next), false); } catch (e) {}
  };
  const saveShopName = async (name) => {
    setShopName(name);
    try { await window.storage.set('shop-settings', JSON.stringify({ shopName: name }), false); } catch (e) {}
  };

  const handleLogin = (e) => {
    e.preventDefault();
    if (pwInput === authPassword) {
      setLoginError('');
      setAuthed(true);
      setPwInput('');
    } else {
      setLoginError('كلمة المرور غير صحيحة');
    }
  };

  const handleLogout = () => {
    setAuthed(false);
    setDataLoaded(false);
    setTab('dashboard');
  };

  const openAddForm = () => {
    setForm({ ...emptyForm, id: null });
    setShowForm(true);
  };
  const openEditForm = (dev) => {
    setForm({ ...dev });
    setShowForm(true);
  };

  const handleSaveDevice = (e) => {
    e.preventDefault();
    if (!form.customerName.trim() || !form.deviceName.trim()) return;
    if (form.id) {
      const next = devices.map((d) => (d.id === form.id ? { ...form } : d));
      saveDevices(next);
    } else {
      const next = [{ ...form, id: uid() }, ...devices];
      saveDevices(next);
    }
    setShowForm(false);
    setForm(emptyForm);
  };

  const handleDeleteDevice = (id) => {
    saveDevices(devices.filter((d) => d.id !== id));
    setConfirmDeleteId(null);
    setShowForm(false);
  };

  const handleAddExpense = (e) => {
    e.preventDefault();
    if (!expenseForm.title.trim() || !expenseForm.amount) return;
    const next = [{ id: uid(), ...expenseForm, amount: Number(expenseForm.amount) }, ...expenses];
    saveExpenses(next);
    setExpenseForm({ title: '', amount: '', date: new Date().toISOString().slice(0, 10) });
    setShowExpenseForm(false);
  };
  const handleDeleteExpense = (id) => {
    saveExpenses(expenses.filter((e) => e.id !== id));
  };

  const handleChangePassword = async (e) => {
    e.preventDefault();
    setPwMsg({ type: '', text: '' });
    if (pwForm.current !== authPassword) {
      setPwMsg({ type: 'error', text: 'كلمة المرور الحالية غير صحيحة' });
      return;
    }
    if (pwForm.next.length < 6) {
      setPwMsg({ type: 'error', text: 'كلمة المرور الجديدة لازم تكون 6 خانات على الأقل' });
      return;
    }
    if (pwForm.next !== pwForm.confirm) {
      setPwMsg({ type: 'error', text: 'تأكيد كلمة المرور غير مطابق' });
      return;
    }
    try {
      await window.storage.set('auth-password', pwForm.next, false);
      setAuthPassword(pwForm.next);
      setPwForm({ current: '', next: '', confirm: '' });
      setPwMsg({ type: 'success', text: 'تم تغيير كلمة المرور بنجاح' });
    } catch (err) {
      setPwMsg({ type: 'error', text: 'حصل خطأ، حاول تاني' });
    }
  };

  const buildBackupText = () => {
    const payload = {
      type: 'repair-shop-backup',
      exportedAt: new Date().toISOString(),
      shopName,
      devices,
      expenses,
    };
    const dateStr = new Date().toLocaleDateString('ar-EG');
    const readable = [
      `نسخة احتياطية - ${shopName}`,
      `تاريخ التصدير: ${dateStr}`,
      `عدد الأجهزة: ${devices.length}`,
      `عدد بنود المصروفات: ${expenses.length}`,
      '──────────────────────────',
      'محتاج ترجّع البيانات دي؟ افتح "استيراد نسخة احتياطية" في إعدادات السيستم، والصق كل النص ده زي ما هو (بما فيه السطر اللي فيه JSON تحت).',
      '──────────────────────────',
      JSON.stringify(payload),
    ].join('\n');
    return readable;
  };

  const handleCopyBackup = async () => {
    const text = buildBackupText();
    try {
      await navigator.clipboard.writeText(text);
      setCopyState('copied');
      setTimeout(() => setCopyState('idle'), 2500);
    } catch (e) {
      setCopyState('failed');
      setTimeout(() => setCopyState('idle'), 2500);
    }
  };

  const handleImportBackup = async (e) => {
    e.preventDefault();
    setImportMsg({ type: '', text: '' });
    try {
      const match = importText.match(/\{[\s\S]*\}/);
      const jsonStr = match ? match[0] : importText;
      const parsed = JSON.parse(jsonStr);
      if (!parsed || !Array.isArray(parsed.devices)) {
        setImportMsg({ type: 'error', text: 'النص ده مش نسخة احتياطية صحيحة' });
        return;
      }
      await saveDevices(parsed.devices || []);
      await saveExpenses(parsed.expenses || []);
      if (parsed.shopName) await saveShopName(parsed.shopName);
      setImportMsg({ type: 'success', text: `تم استرجاع ${parsed.devices.length} جهاز بنجاح` });
      setImportText('');
      setTimeout(() => { setShowImportModal(false); setImportMsg({ type: '', text: '' }); }, 1600);
    } catch (err) {
      setImportMsg({ type: 'error', text: 'مقدرتش أقرا النص ده، اتأكد إنك لزقت النسخة الاحتياطية كاملة' });
    }
  };

  const stats = useMemo(() => {
    const active = devices.filter((d) => d.status !== 'delivered');
    const ready = devices.filter((d) => d.status === 'ready');
    const delivered = devices.filter((d) => d.status === 'delivered');
    const totalIncome = delivered.reduce((s, d) => s + (Number(d.price) || 0), 0);
    const totalExpenses = expenses.reduce((s, e) => s + (Number(e.amount) || 0), 0);
    const pending = active.reduce((s, d) => s + ((Number(d.price) || 0) - (Number(d.deposit) || 0)), 0);
    return {
      activeCount: active.length,
      readyCount: ready.length,
      deliveredCount: delivered.length,
      totalIncome,
      totalExpenses,
      netProfit: totalIncome - totalExpenses,
      pending,
    };
  }, [devices, expenses]);

  const filteredDevices = useMemo(() => {
    return devices
      .filter((d) => (statusFilter === 'all' ? true : d.status === statusFilter))
      .filter((d) => {
        const q = search.trim().toLowerCase();
        if (!q) return true;
        return (
          d.customerName.toLowerCase().includes(q) ||
          d.deviceName.toLowerCase().includes(q) ||
          (d.model || '').toLowerCase().includes(q) ||
          (d.phone || '').toLowerCase().includes(q)
        );
      });
  }, [devices, statusFilter, search]);

  const deliveredDevices = useMemo(
    () => devices.filter((d) => d.status === 'delivered').sort((a, b) => (b.dateDelivered || '').localeCompare(a.dateDelivered || '')),
    [devices]
  );

  const fontStyle = `
    @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap');
    * { font-family: 'Tajawal', system-ui, sans-serif; }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-thumb { background: #22315C; border-radius: 10px; }
    ::-webkit-scrollbar-track { background: transparent; }
    input::placeholder, textarea::placeholder { color: #56638A; }
    @keyframes pulseGlow { 0%,100% { opacity: .55; } 50% { opacity: 1; } }
    @keyframes floatUp { from { opacity: 0; transform: translateY(10px);} to { opacity: 1; transform: translateY(0);} }
    .fade-in { animation: floatUp .25s ease-out; }
  `;

  const bgBase = {
    minHeight: '100vh',
    background:
      'radial-gradient(1100px 500px at 15% -10%, rgba(59,110,255,0.16), transparent 60%), radial-gradient(900px 500px at 100% 0%, rgba(45,212,191,0.08), transparent 55%), #060913',
    color: '#E7ECFF',
    direction: 'rtl',
  };

  // ---------- Boot screen ----------
  if (booting) {
    return (
      <div style={bgBase} className="flex items-center justify-center">
        <style>{fontStyle}</style>
        <div className="flex flex-col items-center gap-3">
          <div className="w-12 h-12 rounded-2xl border-2 border-blue-500 border-t-transparent animate-spin" />
          <span style={{ color: '#8B9AC7' }} className="text-sm">جارِ التحميل...</span>
        </div>
      </div>
    );
  }

  // ---------- Login screen ----------
  if (!authed) {
    return (
      <div style={bgBase} className="flex items-center justify-center p-5">
        <style>{fontStyle}</style>
        <div
          className="w-full max-w-sm rounded-3xl p-7 fade-in"
          style={{
            background: 'linear-gradient(180deg, rgba(20,27,48,0.9), rgba(11,15,28,0.9))',
            border: '1px solid rgba(76,141,255,0.25)',
            boxShadow: '0 0 60px rgba(37,86,255,0.15), 0 20px 60px rgba(0,0,0,0.5)',
            backdropFilter: 'blur(10px)',
          }}
        >
          <div className="flex flex-col items-center mb-6">
            <div
              className="w-16 h-16 rounded-2xl flex items-center justify-center mb-4"
              style={{
                background: 'linear-gradient(135deg, #2563EB, #0EA5A0)',
                boxShadow: '0 0 30px rgba(37,99,235,0.5)',
              }}
            >
              <Smartphone size={30} color="#fff" strokeWidth={2} />
            </div>
            <h1 className="text-xl font-extrabold" style={{ color: '#F1F5FF' }}>{shopName}</h1>
            <p className="text-xs mt-1" style={{ color: '#7C8BB8' }}>نظام إدارة صيانة الأجهزة</p>
          </div>

          <form onSubmit={handleLogin} className="flex flex-col gap-3">
            <div
              className="flex items-center gap-2 rounded-xl px-3 py-3"
              style={{ background: 'rgba(255,255,255,0.03)', border: '1px solid #1E2A4A' }}
            >
              <User size={18} color="#5C7CFA" />
              <span className="text-sm font-semibold" style={{ color: '#C9D4F5' }}>{APP_USER_NAME}</span>
            </div>

            <div
              className="flex items-center gap-2 rounded-xl px-3 py-2.5"
              style={{ background: 'rgba(255,255,255,0.03)', border: loginError ? '1px solid #EF4444' : '1px solid #1E2A4A' }}
            >
              <Lock size={18} color="#5C7CFA" />
              <input
                type={showPw ? 'text' : 'password'}
                value={pwInput}
                onChange={(e) => { setPwInput(e.target.value); setLoginError(''); }}
                placeholder="كلمة المرور"
                className="flex-1 bg-transparent outline-none text-sm py-1"
                style={{ color: '#E7ECFF' }}
                autoFocus
              />
              <button type="button" onClick={() => setShowPw((s) => !s)} className="text-gray-400">
                {showPw ? <EyeOff size={17} /> : <Eye size={17} />}
              </button>
            </div>

            {loginError && (
              <div className="flex items-center gap-1.5 text-xs" style={{ color: '#F87171' }}>
                <AlertCircle size={14} /> {loginError}
              </div>
            )}

            <button
              type="submit"
              className="mt-2 rounded-xl py-3 text-sm font-bold"
              style={{ background: 'linear-gradient(90deg,#2563EB,#1D4ED8)', color: '#fff', boxShadow: '0 8px 24px rgba(37,99,235,0.35)' }}
            >
              دخول
            </button>
          </form>

          <div className="flex items-start gap-2 mt-6 rounded-xl p-3" style={{ background: 'rgba(76,141,255,0.06)', border: '1px solid rgba(76,141,255,0.15)' }}>
            <ShieldCheck size={16} color="#5C7CFA" className="mt-0.5 shrink-0" />
            <p className="text-[11px] leading-relaxed" style={{ color: '#8B9AC7' }}>
              الدخول مقفول بكلمة مرور خاصة بيك، وكل بياناتك متخزنة بشكل خاص ومش ظاهرة لحد غيرك. تقدر تغيّر كلمة المرور من الإعدادات بعد الدخول.
            </p>
          </div>
        </div>
      </div>
    );
  }

  // ---------- Main app ----------
  const NavItem = ({ id, icon: Icon, label }) => (
    <button
      onClick={() => setTab(id)}
      className="flex flex-col items-center justify-center gap-1 flex-1 py-2.5"
      style={{ color: tab === id ? '#5C9CFF' : '#5C6A93' }}
    >
      <Icon size={21} strokeWidth={tab === id ? 2.4 : 2} />
      <span className="text-[10.5px] font-bold">{label}</span>
    </button>
  );

  const StatCard = ({ icon: Icon, label, value, accent }) => (
    <div
      className="rounded-2xl p-4 flex-1 min-w-[140px]"
      style={{ background: 'linear-gradient(160deg, rgba(255,255,255,0.045), rgba(255,255,255,0.015))', border: '1px solid #1B2645' }}
    >
      <div className="flex items-center justify-between mb-3">
        <div className="w-9 h-9 rounded-xl flex items-center justify-center" style={{ background: `${accent}22` }}>
          <Icon size={17} color={accent} />
        </div>
      </div>
      <div className="text-xl font-extrabold" style={{ color: '#F1F5FF' }}>{value}</div>
      <div className="text-[11px] mt-0.5" style={{ color: '#7C8BB8' }}>{label}</div>
    </div>
  );

  const DeviceCard = ({ d }) => {
    const st = STATUS[d.status];
    const StIcon = st.icon;
    return (
      <button
        onClick={() => openEditForm(d)}
        className="w-full text-right rounded-2xl p-4 flex flex-col gap-2.5 fade-in"
        style={{ background: 'linear-gradient(160deg, rgba(255,255,255,0.045), rgba(255,255,255,0.015))', border: '1px solid #1B2645' }}
      >
        <div className="flex items-start justify-between gap-2">
          <div className="flex items-center gap-2.5">
            <div className="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style={{ background: 'rgba(76,141,255,0.12)' }}>
              <Smartphone size={18} color="#5C9CFF" />
            </div>
            <div>
              <div className="text-sm font-bold" style={{ color: '#F1F5FF' }}>{d.deviceName}{d.model ? ` · ${d.model}` : ''}</div>
              <div className="text-xs mt-0.5" style={{ color: '#8B9AC7' }}>{d.customerName}</div>
            </div>
          </div>
          <span
            className="flex items-center gap-1 px-2.5 py-1 rounded-full text-[10.5px] font-bold shrink-0"
            style={{ background: st.bg, color: st.color }}
          >
            <StIcon size={11} /> {st.label}
          </span>
        </div>
        <div className="flex items-center justify-between text-xs pt-2" style={{ borderTop: '1px solid #16203C', color: '#7C8BB8' }}>
          <span className="flex items-center gap-1"><Phone size={12} /> {d.phone || '—'}</span>
          <span className="font-bold" style={{ color: '#E7ECFF' }}>{d.price ? `${Number(d.price).toLocaleString()} ج.م` : '—'}</span>
        </div>
      </button>
    );
  };

  return (
    <div style={bgBase} className="flex flex-col">
      <style>{fontStyle}</style>

      {/* Header */}
      <div className="sticky top-0 z-20 px-5 pt-5 pb-4" style={{ background: 'linear-gradient(180deg, #060913 60%, transparent)' }}>
        <div className="flex items-center justify-between">
          <div>
            <div className="text-[11px]" style={{ color: '#7C8BB8' }}>أهلاً بيك،</div>
            <div className="text-lg font-extrabold" style={{ color: '#F1F5FF' }}>{APP_USER_NAME}</div>
          </div>
          <div className="flex items-center gap-2">
            <div className="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] font-bold" style={{ background: 'rgba(76,141,255,0.1)', color: '#5C9CFF', border: '1px solid rgba(76,141,255,0.2)' }}>
              <Store size={12} /> {shopName}
            </div>
            <button onClick={handleLogout} className="w-9 h-9 rounded-full flex items-center justify-center" style={{ background: 'rgba(255,255,255,0.04)', border: '1px solid #1B2645' }}>
              <LogOut size={15} color="#8B9AC7" />
            </button>
          </div>
        </div>
      </div>

      {/* Content */}
      <div className="flex-1 px-5 pb-28 overflow-y-auto">
        {!dataLoaded ? (
          <div className="flex justify-center py-20">
            <div className="w-8 h-8 rounded-full border-2 border-blue-500 border-t-transparent animate-spin" />
          </div>
        ) : tab === 'dashboard' ? (
          <div className="flex flex-col gap-5 fade-in">
            <div className="flex gap-3 flex-wrap">
              <StatCard icon={Wrench} label="أجهزة قيد التشغيل" value={stats.activeCount} accent="#F5A524" />
              <StatCard icon={Clock} label="جاهزة للتسليم" value={stats.readyCount} accent="#2DD4BF" />
              <StatCard icon={TrendingUp} label="إجمالي الدخل" value={`${stats.totalIncome.toLocaleString()} ج.م`} accent="#22C55E" />
              <StatCard icon={Banknote} label="مبالغ معلقة" value={`${stats.pending.toLocaleString()} ج.م`} accent="#4C8DFF" />
            </div>

            <button
              onClick={openAddForm}
              className="rounded-2xl py-3.5 flex items-center justify-center gap-2 text-sm font-bold"
              style={{ background: 'linear-gradient(90deg,#2563EB,#1D4ED8)', color: '#fff', boxShadow: '0 8px 24px rgba(37,99,235,0.3)' }}
            >
              <Plus size={18} /> إضافة جهاز جديد
            </button>

            <div>
              <div className="flex items-center justify-between mb-3">
                <h2 className="text-sm font-extrabold" style={{ color: '#F1F5FF' }}>آخر الأجهزة</h2>
                <button onClick={() => setTab('devices')} className="text-xs font-bold flex items-center gap-0.5" style={{ color: '#5C9CFF' }}>
                  عرض الكل <ChevronLeft size={13} />
                </button>
              </div>
              <div className="flex flex-col gap-3">
                {devices.slice(0, 4).length === 0 ? (
                  <EmptyState text="لسه معملتش أي جهاز. دوس على «إضافة جهاز جديد» عشان تبدأ." />
                ) : (
                  devices.slice(0, 4).map((d) => <DeviceCard key={d.id} d={d} />)
                )}
              </div>
            </div>
          </div>
        ) : tab === 'devices' ? (
          <div className="flex flex-col gap-4 fade-in">
            <div className="flex items-center gap-2 rounded-xl px-3 py-2.5" style={{ background: 'rgba(255,255,255,0.03)', border: '1px solid #1B2645' }}>
              <Search size={16} color="#5C6A93" />
              <input
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="دور بالاسم أو رقم الهاتف أو الجهاز..."
                className="flex-1 bg-transparent outline-none text-sm"
                style={{ color: '#E7ECFF' }}
              />
            </div>

            <div className="flex gap-2 overflow-x-auto pb-1" style={{ scrollbarWidth: 'none' }}>
              {[{ id: 'all', label: 'الكل' }, ...Object.entries(STATUS).map(([id, v]) => ({ id, label: v.label }))].map((f) => (
                <button
                  key={f.id}
                  onClick={() => setStatusFilter(f.id)}
                  className="px-3.5 py-1.5 rounded-full text-xs font-bold whitespace-nowrap shrink-0"
                  style={
                    statusFilter === f.id
                      ? { background: '#2563EB', color: '#fff' }
                      : { background: 'rgba(255,255,255,0.04)', color: '#8B9AC7', border: '1px solid #1B2645' }
                  }
                >
                  {f.label}
                </button>
              ))}
            </div>

            <div className="flex flex-col gap-3">
              {filteredDevices.length === 0 ? (
                <EmptyState text="مفيش أجهزة مطابقة." />
              ) : (
                filteredDevices.map((d) => <DeviceCard key={d.id} d={d} />)
              )}
            </div>

            <button
              onClick={openAddForm}
              className="fixed bottom-24 left-5 w-14 h-14 rounded-full flex items-center justify-center z-30"
              style={{ background: 'linear-gradient(135deg,#2563EB,#0EA5A0)', boxShadow: '0 10px 30px rgba(37,99,235,0.5)' }}
            >
              <Plus size={24} color="#fff" />
            </button>
          </div>
        ) : tab === 'accounts' ? (
          <div className="flex flex-col gap-5 fade-in">
            <div className="grid grid-cols-2 gap-3">
              <StatCard icon={TrendingUp} label="إجمالي الدخل" value={`${stats.totalIncome.toLocaleString()} ج.م`} accent="#22C55E" />
              <StatCard icon={Receipt} label="إجمالي المصروفات" value={`${stats.totalExpenses.toLocaleString()} ج.م`} accent="#F87171" />
              <StatCard icon={Wallet} label="صافي الربح" value={`${stats.netProfit.toLocaleString()} ج.م`} accent="#5C9CFF" />
              <StatCard icon={PackageCheck} label="أجهزة تم تسليمها" value={stats.deliveredCount} accent="#2DD4BF" />
            </div>

            <div>
              <h2 className="text-sm font-extrabold mb-3" style={{ color: '#F1F5FF' }}>الأجهزة المُسلَّمة وأسعارها</h2>
              <div className="flex flex-col gap-2.5">
                {deliveredDevices.length === 0 ? (
                  <EmptyState text="لسه مفيش أجهزة اتسلّمت." />
                ) : (
                  deliveredDevices.map((d) => (
                    <div key={d.id} className="rounded-xl p-3.5 flex items-center justify-between" style={{ background: 'rgba(255,255,255,0.03)', border: '1px solid #1B2645' }}>
                      <div>
                        <div className="text-sm font-bold" style={{ color: '#F1F5FF' }}>{d.deviceName}{d.model ? ` · ${d.model}` : ''}</div>
                        <div className="text-[11px] mt-0.5" style={{ color: '#7C8BB8' }}>{d.customerName} · {d.dateDelivered || '—'}</div>
                      </div>
                      <div className="text-sm font-extrabold" style={{ color: '#22C55E' }}>{Number(d.price || 0).toLocaleString()} ج.م</div>
                    </div>
                  ))
                )}
              </div>
            </div>

            <div>
              <div className="flex items-center justify-between mb-3">
                <h2 className="text-sm font-extrabold" style={{ color: '#F1F5FF' }}>المصروفات</h2>
                <button onClick={() => setShowExpenseForm(true)} className="text-xs font-bold flex items-center gap-1" style={{ color: '#5C9CFF' }}>
                  <Plus size={14} /> إضافة مصروف
                </button>
              </div>
              <div className="flex flex-col gap-2.5">
                {expenses.length === 0 ? (
                  <EmptyState text="لسه مفيش مصروفات مسجّلة." />
                ) : (
                  expenses.map((ex) => (
                    <div key={ex.id} className="rounded-xl p-3.5 flex items-center justify-between" style={{ background: 'rgba(255,255,255,0.03)', border: '1px solid #1B2645' }}>
                      <div>
                        <div className="text-sm font-bold" style={{ color: '#F1F5FF' }}>{ex.title}</div>
                        <div className="text-[11px] mt-0.5" style={{ color: '#7C8BB8' }}>{ex.date}</div>
                      </div>
                      <div className="flex items-center gap-3">
                        <span className="text-sm font-extrabold" style={{ color: '#F87171' }}>-{Number(ex.amount).toLocaleString()} ج.م</span>
                        <button onClick={() => handleDeleteExpense(ex.id)}><Trash2 size={15} color="#5C6A93" /></button>
                      </div>
                    </div>
                  ))
                )}
              </div>
            </div>
          </div>
        ) : (
          <div className="flex flex-col gap-5 fade-in">
            <div className="rounded-2xl p-4" style={{ background: 'rgba(255,255,255,0.03)', border: '1px solid #1B2645' }}>
              <h2 className="text-sm font-extrabold mb-3 flex items-center gap-2" style={{ color: '#F1F5FF' }}><Store size={16} color="#5C9CFF" /> اسم المحل</h2>
              <div className="flex gap-2">
                <input
                  value={shopNameDraft || shopName}
                  onChange={(e) => setShopNameDraft(e.target.value)}
                  className="flex-1 rounded-xl px-3 py-2.5 text-sm outline-none"
                  style={{ background: 'rgba(255,255,255,0.03)', border: '1px solid #1E2A4A', color: '#E7ECFF' }}
                />
                <button
                  onClick={() => { if (shopNameDraft.trim()) { saveShopName(shopNameDraft.trim()); setShopNameDraft(''); } }}
                  className="px-4 rounded-xl text-sm font-bold"
                  style={{ background: '#2563EB', color: '#fff' }}
                >
                  حفظ
                </button>
              </div>
            </div>

            <div className="rounded-2xl p-4" style={{ background: 'rgba(255,255,255,0.03)', border: '1px solid #1B2645' }}>
              <h2 className="text-sm font-extrabold mb-3 flex items-center gap-2" style={{ color: '#F1F5FF' }}><Lock size={16} color="#5C9CFF" /> تغيير كلمة المرور</h2>
              <form onSubmit={handleChangePassword} className="flex flex-col gap-2.5">
                <input
                  type="password"
                  placeholder="كلمة المرور الحالية"
                  value={pwForm.current}
                  onChange={(e) => setPwForm({ ...pwForm, current: e.target.value })}
                  className="rounded-xl px-3 py-2.5 text-sm outline-none"
                  style={{ background: 'rgba(255,255,255,0.03)', border: '1px solid #1E2A4A', color: '#E7ECFF' }}
                />
                <input
                  type="password"
                  placeholder="كلمة المرور الجديدة"
                  value={pwForm.next}
                  onChange={(e) => setPwForm({ ...pwForm, next: e.target.value })}
                  className="rounded-xl px-3 py-2.5 text-sm outline-none"
                  style={{ background: 'rgba(255,255,255,0.03)', border: '1px solid #1E2A4A', color: '#E7ECFF' }}
                />
                <input
                  type="password"
                  placeholder="تأكيد كلمة المرور الجديدة"
                  value={pwForm.confirm}
                  onChange={(e) => setPwForm({ ...pwForm, confirm: e.target.value })}
                  className="rounded-xl px-3 py-2.5 text-sm outline-none"
                  style={{ background: 'rgba(255,255,255,0.03)', border: '1px solid #1E2A4A', color: '#E7ECFF' }}
                />
                {pwMsg.text && (
                  <div className="text-xs font-bold" style={{ color: pwMsg.type === 'error' ? '#F87171' : '#22C55E' }}>{pwMsg.text}</div>
                )}
                <button type="submit" className="rounded-xl py-2.5 text-sm font-bold mt-1" style={{ background: '#2563EB', color: '#fff' }}>
                  حفظ كلمة المرور الجديدة
                </button>
              </form>
            </div>

            <div className="rounded-2xl p-4" style={{ background: 'rgba(255,255,255,0.03)', border: '1px solid #1B2645' }}>
              <h2 className="text-sm font-extrabold mb-1 flex items-center gap-2" style={{ color: '#F1F5FF' }}><DatabaseBackup size={16} color="#5C9CFF" /> نسخة احتياطية</h2>
              <p className="text-[11px] mb-3.5" style={{ color: '#7C8BB8' }}>
                اعمل نسخة من كل بياناتك (الأجهزة والحسابات) والصقها في مكان تاني عندك (Notes، إيميل لنفسك...) كضمان إضافي.
              </p>
              <div className="flex gap-2.5">
                <button
                  onClick={() => setShowBackupModal(true)}
                  className="flex-1 rounded-xl py-2.5 text-sm font-bold flex items-center justify-center gap-1.5"
                  style={{ background: 'linear-gradient(90deg,#2563EB,#1D4ED8)', color: '#fff' }}
                >
                  <Download size={16} /> نسخ احتياطي
                </button>
                <button
                  onClick={() => setShowImportModal(true)}
                  className="flex-1 rounded-xl py-2.5 text-sm font-bold flex items-center justify-center gap-1.5"
                  style={{ background: 'rgba(255,255,255,0.05)', color: '#C9D4F5', border: '1px solid #1E2A4A' }}
                >
                  <Upload size={16} /> استيراد نسخة
                </button>
              </div>
            </div>

            <div className="flex items-start gap-2 rounded-xl p-3.5" style={{ background: 'rgba(76,141,255,0.06)', border: '1px solid rgba(76,141,255,0.15)' }}>
              <ShieldCheck size={16} color="#5C9CFF" className="mt-0.5 shrink-0" />
              <p className="text-[11px] leading-relaxed" style={{ color: '#8B9AC7' }}>
                البيانات كلها متخزنة بشكل خاص ومربوطة بيك بس. ده تطبيق ويب شغال جوه شات كلود، فمش بيقدر يعمل ربط حقيقي بآيكلود أو إيميل — الحماية هنا هي كلمة المرور وخصوصية التخزين.
              </p>
            </div>

            <button onClick={handleLogout} className="rounded-xl py-3 text-sm font-bold flex items-center justify-center gap-2" style={{ background: 'rgba(248,113,113,0.1)', color: '#F87171', border: '1px solid rgba(248,113,113,0.25)' }}>
              <LogOut size={16} /> تسجيل الخروج
            </button>
          </div>
        )}
      </div>

      {/* Bottom nav */}
      <div className="fixed bottom-0 left-0 right-0 z-30 px-3 pb-3">
        <div className="flex rounded-2xl" style={{ background: 'rgba(11,15,28,0.92)', border: '1px solid #1B2645', backdropFilter: 'blur(14px)' }}>
          <NavItem id="dashboard" icon={LayoutDashboard} label="الرئيسية" />
          <NavItem id="devices" icon={Smartphone} label="الأجهزة" />
          <NavItem id="accounts" icon={Wallet} label="الحسابات" />
          <NavItem id="settings" icon={SettingsIcon} label="الإعدادات" />
        </div>
      </div>

      {/* Device form sheet */}
      {showForm && (
        <div className="fixed inset-0 z-40 flex items-end" style={{ background: 'rgba(0,0,0,0.6)' }} onClick={() => setShowForm(false)}>
          <div
            onClick={(e) => e.stopPropagation()}
            className="w-full max-h-[88vh] overflow-y-auto rounded-t-3xl p-5 fade-in"
            style={{ background: '#0B0F1E', border: '1px solid #1B2645', direction: 'rtl' }}
          >
            <div className="flex items-center justify-between mb-4">
              <h2 className="text-base font-extrabold" style={{ color: '#F1F5FF' }}>{form.id ? 'تعديل بيانات الجهاز' : 'إضافة جهاز جديد'}</h2>
              <button onClick={() => setShowForm(false)}><X size={20} color="#8B9AC7" /></button>
            </div>

            <form onSubmit={handleSaveDevice} className="flex flex-col gap-3">
              <Field label="اسم العميل *">
                <input required value={form.customerName} onChange={(e) => setForm({ ...form, customerName: e.target.value })} className="input" style={inputStyle} />
              </Field>
              <Field label="رقم الهاتف">
                <input value={form.phone} onChange={(e) => setForm({ ...form, phone: e.target.value })} className="input" style={inputStyle} inputMode="tel" />
              </Field>
              <div className="grid grid-cols-2 gap-3">
                <Field label="اسم الجهاز *">
                  <input required value={form.deviceName} onChange={(e) => setForm({ ...form, deviceName: e.target.value })} placeholder="iPhone 13" className="input" style={inputStyle} />
                </Field>
                <Field label="الموديل / اللون">
                  <input value={form.model} onChange={(e) => setForm({ ...form, model: e.target.value })} placeholder="أزرق 128GB" className="input" style={inputStyle} />
                </Field>
              </div>
              <Field label="وصف العطل">
                <textarea value={form.issue} onChange={(e) => setForm({ ...form, issue: e.target.value })} rows={2} className="input" style={inputStyle} />
              </Field>
              <div className="grid grid-cols-2 gap-3">
                <Field label="السعر المتفق عليه">
                  <input type="number" value={form.price} onChange={(e) => setForm({ ...form, price: e.target.value })} className="input" style={inputStyle} inputMode="decimal" />
                </Field>
                <Field label="العربون">
                  <input type="number" value={form.deposit} onChange={(e) => setForm({ ...form, deposit: e.target.value })} className="input" style={inputStyle} inputMode="decimal" />
                </Field>
              </div>
              <Field label="الحالة">
                <select value={form.status} onChange={(e) => setForm({ ...form, status: e.target.value, dateDelivered: e.target.value === 'delivered' && !form.dateDelivered ? new Date().toISOString().slice(0, 10) : form.dateDelivered })} className="input" style={inputStyle}>
                  {Object.entries(STATUS).map(([id, v]) => (
                    <option key={id} value={id} style={{ background: '#0B0F1E' }}>{v.label}</option>
                  ))}
                </select>
              </Field>
              <div className="grid grid-cols-2 gap-3">
                <Field label="تاريخ الاستلام">
                  <input type="date" value={form.dateReceived} onChange={(e) => setForm({ ...form, dateReceived: e.target.value })} className="input" style={inputStyle} />
                </Field>
                <Field label="تاريخ التسليم">
                  <input type="date" value={form.dateDelivered} onChange={(e) => setForm({ ...form, dateDelivered: e.target.value })} className="input" style={inputStyle} />
                </Field>
              </div>
              <Field label="ملاحظات">
                <textarea value={form.notes} onChange={(e) => setForm({ ...form, notes: e.target.value })} rows={2} className="input" style={inputStyle} />
              </Field>

              <div className="flex gap-2.5 mt-2">
                {form.id && (
                  <button
                    type="button"
                    onClick={() => setConfirmDeleteId(form.id)}
                    className="w-12 rounded-xl flex items-center justify-center"
                    style={{ background: 'rgba(248,113,113,0.1)', border: '1px solid rgba(248,113,113,0.3)' }}
                  >
                    <Trash2 size={18} color="#F87171" />
                  </button>
                )}
                <button type="submit" className="flex-1 rounded-xl py-3 text-sm font-bold" style={{ background: 'linear-gradient(90deg,#2563EB,#1D4ED8)', color: '#fff' }}>
                  {form.id ? 'حفظ التعديلات' : 'إضافة الجهاز'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Expense form sheet */}
      {showExpenseForm && (
        <div className="fixed inset-0 z-40 flex items-end" style={{ background: 'rgba(0,0,0,0.6)' }} onClick={() => setShowExpenseForm(false)}>
          <div onClick={(e) => e.stopPropagation()} className="w-full rounded-t-3xl p-5 fade-in" style={{ background: '#0B0F1E', border: '1px solid #1B2645', direction: 'rtl' }}>
            <div className="flex items-center justify-between mb-4">
              <h2 className="text-base font-extrabold" style={{ color: '#F1F5FF' }}>إضافة مصروف</h2>
              <button onClick={() => setShowExpenseForm(false)}><X size={20} color="#8B9AC7" /></button>
            </div>
            <form onSubmit={handleAddExpense} className="flex flex-col gap-3">
              <Field label="البند">
                <input required value={expenseForm.title} onChange={(e) => setExpenseForm({ ...expenseForm, title: e.target.value })} className="input" style={inputStyle} placeholder="إيجار، قطع غيار، فاتورة كهرباء..." />
              </Field>
              <div className="grid grid-cols-2 gap-3">
                <Field label="المبلغ">
                  <input required type="number" value={expenseForm.amount} onChange={(e) => setExpenseForm({ ...expenseForm, amount: e.target.value })} className="input" style={inputStyle} inputMode="decimal" />
                </Field>
                <Field label="التاريخ">
                  <input type="date" value={expenseForm.date} onChange={(e) => setExpenseForm({ ...expenseForm, date: e.target.value })} className="input" style={inputStyle} />
                </Field>
              </div>
              <button type="submit" className="rounded-xl py-3 text-sm font-bold mt-1" style={{ background: 'linear-gradient(90deg,#2563EB,#1D4ED8)', color: '#fff' }}>
                إضافة
              </button>
            </form>
          </div>
        </div>
      )}

      {/* Backup modal */}
      {showBackupModal && (
        <div className="fixed inset-0 z-50 flex items-end" style={{ background: 'rgba(0,0,0,0.7)' }} onClick={() => setShowBackupModal(false)}>
          <div onClick={(e) => e.stopPropagation()} className="w-full max-h-[80vh] overflow-y-auto rounded-t-3xl p-5 fade-in" style={{ background: '#0B0F1E', border: '1px solid #1B2645', direction: 'rtl' }}>
            <div className="flex items-center justify-between mb-3">
              <h2 className="text-base font-extrabold flex items-center gap-2" style={{ color: '#F1F5FF' }}><DatabaseBackup size={18} color="#5C9CFF" /> نسخة احتياطية</h2>
              <button onClick={() => setShowBackupModal(false)}><X size={20} color="#8B9AC7" /></button>
            </div>
            <p className="text-[11px] mb-3" style={{ color: '#7C8BB8' }}>
              دوس "نسخ" وبعدين الصق النص ده في أي مكان عندك (Notes، إيميل، واتساب لنفسك). لو عايز ترجّع البيانات بعدين، استخدم "استيراد نسخة" والصق نفس النص كامل.
            </p>
            <textarea
              readOnly
              value={buildBackupText()}
              rows={10}
              className="w-full rounded-xl px-3 py-2.5 text-[11px] outline-none mb-3"
              style={{ background: 'rgba(255,255,255,0.03)', border: '1px solid #1E2A4A', color: '#8B9AC7', direction: 'ltr', textAlign: 'left' }}
              onFocus={(e) => e.target.select()}
            />
            <button
              onClick={handleCopyBackup}
              className="w-full rounded-xl py-3 text-sm font-bold flex items-center justify-center gap-2"
              style={{ background: copyState === 'copied' ? '#16A34A' : 'linear-gradient(90deg,#2563EB,#1D4ED8)', color: '#fff' }}
            >
              {copyState === 'copied' ? (<><ClipboardCheck size={17} /> تم النسخ</>) : copyState === 'failed' ? ('حاول تعمل تحديد ونسخ يدوي') : (<><Download size={17} /> نسخ النسخة الاحتياطية</>)}
            </button>
          </div>
        </div>
      )}

      {/* Import modal */}
      {showImportModal && (
        <div className="fixed inset-0 z-50 flex items-end" style={{ background: 'rgba(0,0,0,0.7)' }} onClick={() => setShowImportModal(false)}>
          <div onClick={(e) => e.stopPropagation()} className="w-full max-h-[80vh] overflow-y-auto rounded-t-3xl p-5 fade-in" style={{ background: '#0B0F1E', border: '1px solid #1B2645', direction: 'rtl' }}>
            <div className="flex items-center justify-between mb-3">
              <h2 className="text-base font-extrabold flex items-center gap-2" style={{ color: '#F1F5FF' }}><Upload size={18} color="#5C9CFF" /> استيراد نسخة احتياطية</h2>
              <button onClick={() => setShowImportModal(false)}><X size={20} color="#8B9AC7" /></button>
            </div>
            <p className="text-[11px] mb-3" style={{ color: '#F5A524' }}>
              تنبيه: الاستيراد هيستبدل كل البيانات الحالية بالبيانات اللي في النسخة الاحتياطية.
            </p>
            <form onSubmit={handleImportBackup} className="flex flex-col gap-3">
              <textarea
                value={importText}
                onChange={(e) => setImportText(e.target.value)}
                rows={8}
                placeholder="الصق نص النسخة الاحتياطية هنا كامل..."
                className="w-full rounded-xl px-3 py-2.5 text-[11px] outline-none"
                style={{ background: 'rgba(255,255,255,0.03)', border: '1px solid #1E2A4A', color: '#E7ECFF', direction: 'ltr', textAlign: 'left' }}
              />
              {importMsg.text && (
                <div className="text-xs font-bold" style={{ color: importMsg.type === 'error' ? '#F87171' : '#22C55E' }}>{importMsg.text}</div>
              )}
              <button type="submit" className="rounded-xl py-3 text-sm font-bold" style={{ background: 'linear-gradient(90deg,#2563EB,#1D4ED8)', color: '#fff' }}>
                استرجاع البيانات
              </button>
            </form>
          </div>
        </div>
      )}

      {/* Delete confirm */}
      {confirmDeleteId && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-6" style={{ background: 'rgba(0,0,0,0.7)' }} onClick={() => setConfirmDeleteId(null)}>
          <div onClick={(e) => e.stopPropagation()} className="w-full max-w-xs rounded-2xl p-5 fade-in" style={{ background: '#0B0F1E', border: '1px solid #1B2645', direction: 'rtl' }}>
            <h3 className="text-sm font-extrabold mb-2" style={{ color: '#F1F5FF' }}>حذف الجهاز؟</h3>
            <p className="text-xs mb-4" style={{ color: '#8B9AC7' }}>مش هينفع ترجّع البيانات دي تاني بعد الحذف.</p>
            <div className="flex gap-2.5">
              <button onClick={() => setConfirmDeleteId(null)} className="flex-1 rounded-xl py-2.5 text-sm font-bold" style={{ background: 'rgba(255,255,255,0.05)', color: '#C9D4F5' }}>إلغاء</button>
              <button onClick={() => handleDeleteDevice(confirmDeleteId)} className="flex-1 rounded-xl py-2.5 text-sm font-bold" style={{ background: '#EF4444', color: '#fff' }}>حذف</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

const inputStyle = {
  background: 'rgba(255,255,255,0.03)',
  border: '1px solid #1E2A4A',
  color: '#E7ECFF',
};

function Field({ label, children }) {
  return (
    <label className="flex flex-col gap-1.5">
      <span className="text-[11.5px] font-bold" style={{ color: '#8B9AC7' }}>{label}</span>
      {React.cloneElement(children, {
        className: `${children.props.className || ''} rounded-xl px-3 py-2.5 text-sm outline-none w-full`.trim(),
      })}
    </label>
  );
}

function EmptyState({ text }) {
